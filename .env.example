# Copy this file to .env before starting Docker Compose.
# Use unique, strong values outside local development. Never commit .env.
POSTGRES_DB=elderly_ai
POSTGRES_USER=elderly_ai
POSTGRES_PASSWORD=replace_with_a_strong_password

# Optional: override when the default PyPI index is unreachable.
PIP_INDEX_URL=https://pypi.org/simple
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130

# M2 EZVIZ Open API. Replace only in local .env; never commit real values.
EZVIZ_APP_KEY=your_app_key
EZVIZ_APP_SECRET=your_app_secret
EZVIZ_API_BASE_URL=https://open.ys7.com
# The official EZOPEN Web SDK requires a runtime AccessToken in the browser.
# Enable only for a trusted deployment; the response is no-store and not logged.
EZVIZ_BROWSER_PLAYBACK_ENABLED=false
EZVIZ_EZOPEN_DOMAIN=open.ys7.com

# M4 internal AI realtime pipeline (replace this local development value)
APP_ENV=development
AI_WORKER_SHARED_TOKEN=change-me
AI_WORKER_ID=careshield-worker-1
AI_WORKER_VERSION=0.5.0
AI_WORKER_TTL_SECONDS=30
AI_LATEST_RESULT_TTL_SECONDS=3600
AI_WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# M6 isolated batch worker. It reports unavailable until the VisionMD runtime
# and licensed GVHMR body-model assets are installed; no fake risk is produced.
FALL_RISK_WORKER_ID=careshield-fall-risk-1
FALL_RISK_WORKER_VERSION=0.6.1
FALL_RISK_CHANNEL_NO=1

# M6 core fall-risk model. Point these to a local MotionCLIP checkout and its
# isolated runtime; neither the 216 MB checkpoint nor the 6.5 GB environment is
# copied into Git. The default profile has no clinical risk-level calibration.
MOTIONCLIP_CHECKPOINT_PATH=/path/to/MotionCLIP/exps/carepd_motionclip_encoder_only_reference_diff_ft/checkpoint_best.pth.tar
MOTIONCLIP_RUNTIME_ROOT=/path/to/MotionCLIP/.runtime/conda-env
MOTIONCLIP_PROFILE=carepd_four_dataset_explainable
MOTIONCLIP_DEVICE=auto

# M5 pose-based fall detection. Leave FALL_DEVICE_SERIAL empty to select the
# first online CareShield media device. Never put EZVIZ credentials in Worker env.
FALL_DETECTION_ENABLED=true
AI_DEVICE=auto
FALL_DEVICE_SERIAL=
FALL_CHANNEL_NO=1
# YOLO-series person/COCO17 pose model. Benchmark replacements before changing it.
FALL_MODEL_NAME=yolo26m-pose.pt
FALL_PERSON_MODEL_NAME=yolo26s.pt
FALL_CLASSIFIER_MODEL_FILE=stgcn-extend-real440.pth
FALL_CLASSIFIER_MODEL_NAME=stgcn-extend-real440
FALL_INPUT_FPS=15
FALL_INPUT_SIZE=960
FALL_POSE_CONFIDENCE=0.20
FALL_PERSON_CONFIDENCE=0.20
FALL_MIN_KEYPOINT_CONFIDENCE=0.35
FALL_MIN_SEQUENCE_VALID_RATIO=0.80
FALL_OBSERVATION_WINDOW_SECONDS=2.0
FALL_RESULT_HEARTBEAT_SECONDS=1
FALL_CLASSIFIER_INFERENCE_HZ=2
FALL_STGCN_SUSPECTED_THRESHOLD=0.60
FALL_STGCN_FALLEN_THRESHOLD=0.80
FALL_STGCN_CONFIRMATION_WINDOWS=1
FALL_STGCN_RECOVERY_WINDOWS=5
FALL_TRACKING_MINIMUM_IOU=0.25
FALL_TRACKING_MAXIMUM_MISSING_FRAMES=30
FALL_TRACKING_MAXIMUM_CENTER_DISTANCE=0.45
# Optional regional mirrors used by scripts/bootstrap_gvhmr_runtime.sh.
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
